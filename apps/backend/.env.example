# Spec §4.3: configurable paths, no hardcoded locations.
DEVYARD_HOST=127.0.0.1
DEVYARD_PORT=4000
DEVYARD_DATA_DIR=./data
DEVYARD_DB_PATH=./data/devyard.sqlite
DEVYARD_SESSION_TTL_HOURS=168
DEVYARD_SESSION_IDLE_HOURS=24
DEVYARD_COOKIE_SECURE=false
DEVYARD_LOG_LEVEL=info
# Exact origins (scheme://host[:port]) allowed on unsafe requests. Required in production.
DEVYARD_PUBLIC_ORIGINS=http://localhost:4000,http://localhost:5173
# Off by default. Set to the reverse proxy's IP/CIDR (e.g. 127.0.0.1) so X-Forwarded-For is honoured.
# DEVYARD_TRUST_PROXY=127.0.0.1
